# Porta em que o servidor escuta
PORT=8001

# URL pública usada nos links do console e no Swagger (sem barra no final)
# Ex.: https://dbaudiosync.ngrok.app
PUBLIC_URL=http://localhost:8001

# Tamanho máximo de upload de vídeo/áudio pelo admin, em MB
MAX_UPLOAD_MB=500

# Login do admin (/login)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Chave usada para validar as sessões do admin. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar a senha ou esta chave desloga todo mundo.
# As sessões ficam em sessions.json (ao lado do totems.json, ou no bucket no modo S3);
# "Sair" encerra a sessão de verdade e o admin tem "Desconectar outros aparelhos".
SESSION_SECRET=

# Proteção para sites públicos
# Máximo de telas abertas por IP e por campanha
MAX_SCREENS_PER_IP=20
MAX_INSTANCES_PER_CAMPAIGN=2000
# Use 1 quando o servidor estiver atrás de proxy/túnel (ngrok, Nginx, Cloudflare)
TRUST_PROXY=0

# CORS: desligado por padrão (páginas, iframes e celulares usam o próprio servidor).
# Só preencha se outro site precisar ler /media ou /health direto pelo navegador.
# Lista separada por vírgula, ex.: https://meusite.com,https://outro.com  (ou * para qualquer um)
CORS_ORIGINS=

# ── Mídia no S3 (opcional) ─────────────────────────────────────────────────
# Com S3_BUCKET definido, a biblioteca de mídia fica SÓ no bucket: o admin
# lista, envia, separa, substitui, renomeia e exclui direto no S3, e a pasta
# assets/ não é usada. Sem S3_BUCKET, tudo fica em assets/ (modo local).
# As campanhas (totems.json) também ficam no bucket, em <prefixo>/totems.json,
# compartilhadas por todos os servidores com o mesmo bucket+prefixo. Na primeira
# partida, se o bucket não tiver o arquivo, ele é criado a partir do totems.json local.
# USE UM PREFIXO POR AMBIENTE (ex.: audiosync em produção, audiosync-dev no seu computador).
# Para migrar arquivos de uma pasta local para o bucket: npm run s3-sync
# Permissões do usuário IAM: s3:ListBucket no bucket e
# s3:GetObject / s3:PutObject / s3:DeleteObject nos objetos.
S3_BUCKET=
S3_REGION=sa-east-1
# Pasta dentro do bucket (opcional), ex.: audiosync
S3_PREFIX=
# Credenciais de um usuário IAM com acesso só a esse bucket (ou use um IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Só para armazenamento compatível com S3 (MinIO, Cloudflare R2). Vazio = AWS.
S3_ENDPOINT=

# De onde os visitantes baixam vídeos e áudios.
# Vazio = endereço público do bucket (modo S3) ou o próprio servidor (/media, modo local).
# S3 direto:  https://<bucket>.s3.<região>.amazonaws.com/audiosync
# CloudFront: https://dxxxxxxxx.cloudfront.net/audiosync
MEDIA_BASE_URL=
# A cada quantos ms cada servidor confere se outro servidor mudou as campanhas (padrão 15000)
CONFIG_REFRESH_MS=15000
# Celulares por IP (folgados: muitos aparelhos dividem o mesmo IP em Wi-Fi de evento e operadoras)
MAX_PHONES_PER_IP=50
MAX_SYNCS_PER_IP_PER_MINUTE=120

# Estatísticas (admin → Estatísticas): um arquivo por dia, guardado por 90 dias,
# em <prefixo>/stats/ no bucket (modo S3) ou na pasta stats/ ao lado do totems.json.
# Fuso horário que define a virada do dia
STATS_TIMEZONE=America/Sao_Paulo
# A cada quantos ms cada servidor soma suas contagens no arquivo do dia (padrão 60000)
STATS_FLUSH_MS=60000
